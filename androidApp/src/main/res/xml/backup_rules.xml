<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. Mirrors data_extraction_rules.xml. -->
<full-backup-content>
    <exclude domain="file" path="datastore/secure_session.preferences_pb" />
    <exclude domain="file" path="datastore/app_prefs.preferences_pb" />
    <exclude domain="database" path="saveme.db" />
    <exclude domain="database" path="saveme.db-wal" />
    <exclude domain="database" path="saveme.db-shm" />
</full-backup-content>
